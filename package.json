{
  "name": "sejong-quarantine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build",
    "dev": "npm run build && wrangler dev --local --ip 0.0.0.0 --port 8787",
    "db:migrate": "wrangler d1 migrations apply sejong-db --local",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.0",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  }
}
